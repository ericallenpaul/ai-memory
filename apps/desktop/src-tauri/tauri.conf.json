{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIMemory Desktop",
  "version": "0.1.0",
  "identifier": "com.aimemory.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepublish:dotnet && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIMemory Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bundle-resources/api/": "api/",
      "bundle-resources/ingestor/": "ingestor/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./installer/installer.nsh",
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}

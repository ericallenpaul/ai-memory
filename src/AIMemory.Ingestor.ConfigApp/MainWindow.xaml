<Window x:Class="AIMemory.Ingestor.ConfigApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AIMemory.Ingestor.ConfigApp.Views"
        Title="AIMemory Ingestor Configuration"
        Width="800" Height="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,12">
                <TextBlock Text="AIMemory" FontSize="16" FontWeight="Bold" Margin="16,0,0,16" Foreground="#0078D4"/>
                <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="NavList_SelectionChanged" SelectedIndex="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="General Settings"/>
                    <ListBoxItem Content="Sources"/>
                    <ListBoxItem Content="Redaction"/>
                    <ListBoxItem Content="Service Status"/>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="ContentArea" Margin="24,16"/>
        </ScrollViewer>
    </Grid>
</Window>

<UserControl x:Class="AIMemory.Ingestor.ConfigApp.Views.GeneralSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="General Settings" Style="{StaticResource SectionHeader}"/>

        <TextBlock Text="API URL" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13"/>

        <TextBlock Text="API Key" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13"/>

        <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13"/>

        <TextBlock Text="Scan Interval (seconds)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding ScanIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13" Width="100" HorizontalAlignment="Left"/>

        <TextBlock Text="Batch Size" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13" Width="100" HorizontalAlignment="Left"/>

        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                Margin="0,20,0,0" HorizontalAlignment="Left"/>

        <TextBlock Text="{Binding StatusMessage}" Foreground="Green" FontSize="13" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>

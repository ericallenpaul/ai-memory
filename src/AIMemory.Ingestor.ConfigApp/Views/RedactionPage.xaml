<UserControl x:Class="AIMemory.Ingestor.ConfigApp.Views.RedactionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AIMemory.Ingestor.ConfigApp.ViewModels">
    <StackPanel>
        <TextBlock Text="Redaction Settings" Style="{StaticResource SectionHeader}"/>

        <TextBlock Text="Mode" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{x:Static vm:MainViewModel.RedactionModes}"
                  SelectedItem="{Binding RedactionMode}" Width="160" HorizontalAlignment="Left"/>

        <TextBlock Text="File/Path Exclusions (one per line)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Exclusions, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="120" Padding="6" FontSize="13"/>

        <TextBlock Text="Exclusion patterns prevent specific files or directories from being ingested. Examples: .env, secrets/, *.pem"
                   Foreground="#999" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                Margin="0,20,0,0" HorizontalAlignment="Left"/>

        <TextBlock Text="{Binding StatusMessage}" Foreground="Green" FontSize="13" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>

<UserControl x:Class="AIMemory.Ingestor.ConfigApp.Views.ServiceStatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Service Status" Style="{StaticResource SectionHeader}"/>

        <!-- Service control -->
        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Service:" FontSize="14" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ServiceStatus}" FontSize="14" VerticalAlignment="Center" Foreground="#0078D4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Start" Command="{Binding StartServiceCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Stop" Command="{Binding StopServiceCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Restart" Command="{Binding RestartServiceCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Refresh" Command="{Binding RefreshServiceStatusCommand}" Padding="12,6"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Foreground="#666" FontSize="13" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Checkpoint summary -->
        <TextBlock Text="Checkpoint Summary" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <DataGrid ItemsSource="{Binding Checkpoints}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="1" BorderBrush="#DDD" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File Path" Binding="{Binding FilePath}" Width="*"/>
                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="80"/>
                <DataGridTextColumn Header="File Size" Binding="{Binding FileSize}" Width="80"/>
                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>

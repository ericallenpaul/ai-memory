<Window x:Class="AIMemory.Ingestor.ConfigApp.Views.SetupWizardPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AIMemory.Ingestor.ConfigApp.ViewModels"
        Title="AIMemory Ingestor — Setup Wizard"
        Width="600" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.DataContext>
        <vm:SetupWizardViewModel/>
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="AIMemory Ingestor Setup" FontSize="22" FontWeight="Bold"/>
            <TextBlock FontSize="13" Foreground="#666" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Step 1 of 3: API Connection"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                <Setter Property="Text" Value="Step 2 of 3: Sources"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                <Setter Property="Text" Value="Step 3 of 3: Confirm"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Step 0: API Connection -->
        <StackPanel Grid.Row="1">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="API URL" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13"/>

            <TextBlock Text="API Key (optional)" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="ApiKeyBox" Padding="6" FontSize="13"
                         PasswordChanged="ApiKeyBox_PasswordChanged"/>

            <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Test Connection" Command="{Binding TestConnectionCommand}"
                        Style="{StaticResource PrimaryButton}"/>
                <TextBlock Text="{Binding ConnectionTestResult}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <!-- Step 1: Sources -->
        <StackPanel Grid.Row="1">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="Detected sources on this machine:" FontSize="14" Margin="0,0,0,12"/>

            <ItemsControl ItemsSource="{Binding DetectedSources}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding WatchPaths}" Foreground="#666" FontSize="12" Margin="26,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Segment" FontSize="12" Foreground="#666"/>
                                    <ComboBox ItemsSource="{x:Static vm:SourceConfigViewModel.SegmentOptions}"
                                              SelectedItem="{Binding Segment}" Width="100"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No sources detected." Foreground="#999" FontStyle="Italic" Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DetectedSources.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Step 2: Confirm -->
        <StackPanel Grid.Row="1">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="Configuration Summary" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock FontSize="13" Margin="0,4">
                <Run Text="API URL: " FontWeight="SemiBold"/>
                <Run Text="{Binding ApiUrl, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock FontSize="13" Margin="0,4">
                <Run Text="Client ID: " FontWeight="SemiBold"/>
                <Run Text="{Binding ClientId, Mode=OneWay}"/>
            </TextBlock>

            <TextBlock Text="Sources:" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,4"/>
            <ItemsControl ItemsSource="{Binding DetectedSources}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="13" Margin="12,2">
                            <Run Text="{Binding Name, Mode=OneWay}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding Segment, Mode=OneWay}"/>
                            <Run Text=" — "/>
                            <Run>
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="enabled"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter Property="Text" Value="disabled"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Click Finish to save configuration and start using AIMemory Ingestor."
                       FontSize="13" Foreground="#666" Margin="0,20,0,0"/>
        </StackPanel>

        <!-- Navigation buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Back" Command="{Binding PreviousStepCommand}" Padding="16,8" Margin="0,0,8,0"
                    IsEnabled="{Binding CanGoBack}"/>
            <Button Content="Next" Command="{Binding NextStepCommand}" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Finish" Click="Finish_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>

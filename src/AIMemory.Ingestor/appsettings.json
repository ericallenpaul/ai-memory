{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Ingestor": {
    "AIMemoryApiBaseUrl": "",
    "ClientId": "eric-windows-01",
    "ScanIntervalSeconds": 5,
    "BatchSize": 100,
    "Sources": [
      {
        "Name": "claude-code",
        "Enabled": true,
        "AdapterType": "ClaudeCode",
        "WatchPaths": ["C:\\Users\\erica\\.claude\\projects"],
        "FilePatterns": ["*.jsonl"],
        "Segment": "personal"
      },
      {
        "Name": "codex-cli",
        "Enabled": true,
        "AdapterType": "CodexCli",
        "WatchPaths": ["C:\\Users\\erica\\.codex"],
        "FilePatterns": ["history.jsonl"],
        "Segment": "personal"
      }
    ],
    "Redaction": {
      "Mode": "basic",
      "Exclusions": []
    },
    "Outbox": {
      "MaxSizeMb": 100
    }
  }
}
